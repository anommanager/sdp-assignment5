@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam interface {
  BackgroundColor #E8F0FE
  BorderColor #333333
}
hide empty members
left to right direction

enum ExamType {
  FINAL
  PRACTICE
  QUIZ
}

interface ReactStrategy {
  +react(roomId: String): String
}
class WarnStrategy {
  -log: IncidentLog
}
class PauseStrategy {
  -log: IncidentLog
  -clock: Clock
  -seconds: int
}
class TerminateStrategy {
  -log: IncidentLog
}
class NoiseBasedReaction {
  -sensor: NoiseSensor
  -quiet: ReactStrategy
  -medium: ReactStrategy
  -loud: ReactStrategy
}
class ViolationHandler {
  -strategy: ReactStrategy
  +setStrategy(ReactStrategy)
  +handle(roomId: String): String
}
class ReactSelector {
  +select(violationNumber: int, ExamType): ReactStrategy
}
class IncidentLog {
  +add(entry: String)
  +entries(): List<String>
}

interface ProctorStrategy {
  +pick(List<Proctor>): Proctor
}
class LeastLoadedStrategy
class BestRatedStrategy
class RoundRobinStrategy {
  -next: int
}
class ProctorAssigner {
  -strategy: ProctorStrategy
  +setStrategy(ProctorStrategy)
  +assign(List<Proctor>): Proctor
}
class ProctorSelector {
  +select(ExamType, students: int): ProctorStrategy
}
class Proctor <<record>> {
  name: String
  activeRooms: int
  rating: double
}

interface NoiseSensor {
  +levelDb(roomId: String): int
}
class SimulatedNoiseSensor

ReactStrategy <|.. WarnStrategy
ReactStrategy <|.. PauseStrategy
ReactStrategy <|.. TerminateStrategy
ReactStrategy <|.. NoiseBasedReaction
ViolationHandler o-- ReactStrategy
NoiseBasedReaction o-- ReactStrategy
NoiseBasedReaction --> NoiseSensor
WarnStrategy --> IncidentLog
PauseStrategy --> IncidentLog
TerminateStrategy --> IncidentLog
ReactSelector ..> ReactStrategy : creates
ReactSelector ..> ExamType
ReactSelector --> NoiseSensor

ProctorStrategy <|.. LeastLoadedStrategy
ProctorStrategy <|.. BestRatedStrategy
ProctorStrategy <|.. RoundRobinStrategy
ProctorAssigner o-- ProctorStrategy
ProctorSelector ..> ProctorStrategy : creates
ProctorSelector ..> ExamType
ProctorStrategy ..> Proctor

NoiseSensor <|.. SimulatedNoiseSensor
@enduml
